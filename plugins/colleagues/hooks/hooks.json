{
  "description": "Reminds at every prompt which colleagues are speaking, and brings them back after a compaction or a resume.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/conversation.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/conversation.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
